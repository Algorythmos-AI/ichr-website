{
  "name": "ichr-web",
  "private": true,
  "version": "1.0.19",
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "prisma generate && astro build",
    "preview": "astro preview",
    "start": "astro preview",
    "astro": "astro",
    "check": "astro check",
    "typecheck": "astro sync && tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --experimental-strip-types --test \"src/lib/**/*.test.ts\" \"prisma/lib/**/*.test.mjs\"",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:seed": "prisma db seed",
    "postinstall": "prisma generate",
    "audit:deps": "node scripts/ci/audit-deps.mjs",
    "verify": "npm run typecheck && npm run check && npm run lint && npm run format:check && npm test && npm run build"
  },
  "prisma": {
    "seed": "node prisma/seed.mjs"
  },
  "dependencies": {
    "@astrojs/react": "^7.1.0",
    "@astrojs/vercel": "^11.0.15",
    "@neondatabase/serverless": "^1.2.0",
    "@prisma/client": "^5.22.0",
    "@vercel/blob": "^2.8.2",
    "astro": "^7.4.0",
    "bcryptjs": "^3.0.3",
    "dompurify": "^3.4.17",
    "jsonwebtoken": "^9.0.2",
    "leaflet": "1.9.4",
    "lucide-react": "^1.59.0",
    "marked": "^18.1.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sanitize-html": "^2.18.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/sanitize-html": "^2.16.2",
    "eslint": "^10.13.0",
    "eslint-plugin-astro": "^3.2.1",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "prisma": "^5.22.0",
    "sharp": "^0.35.4",
    "tailwindcss": "^4.1.18",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.71.2"
  },
  "allowScripts": {
    "prisma@5.22.0": true,
    "@prisma/client@5.22.0": true,
    "@prisma/engines@5.22.0": true,
    "esbuild@0.28.2": true,
    "esbuild@0.25.12": true,
    "fsevents@2.3.3": true
  },
  "overrides": {
    "eslint-plugin-jsx-a11y": {
      "eslint": "$eslint"
    },
    "@vercel/routing-utils": {
      "path-to-regexp": "6.3.0"
    }
  }
}
